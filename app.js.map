    "part": "#4a90d9",
    "attribute": "#4caf6d",
    "port": "#2bb6b6",
    "item": "#29b6c8",
    "action": "#d98a2b",
    "state": "#9b6dd0",
    "connection": "#8a8f98",
    "requirement": "#d95757",
    "package": "#8a8f98",
    "default": "#888888"
  }
}
